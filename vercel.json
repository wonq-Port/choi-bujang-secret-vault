{
  "rewrites": [
    { "source": "/api/device", "destination": "/api/memos?action=device" },
    { "source": "/api/restore", "destination": "/api/memos?action=restore" },
    { "source": "/api/memos/:id", "destination": "/api/memos?id=:id" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
